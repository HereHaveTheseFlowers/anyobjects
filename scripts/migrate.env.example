# Скопируйте в scripts/migrate.env и заполните.
# Файл migrate.env не коммитится в git.

# Логин/пароль от старой Firebase-админки
FIREBASE_EMAIL=your@email.com
FIREBASE_PASSWORD=your_firebase_password

# Опционально: прямой импорт в MySQL с вашего компьютера
# (работает только если хостинг разрешает внешние подключения к MySQL)
# MYSQL_HOST=localhost
# MYSQL_DATABASE=your_db
# MYSQL_USER=your_user
# MYSQL_PASSWORD=your_password

# Картинки из GitHub (public/objects в репозитории)
GITHUB_OBJECTS_BASE=https://raw.githubusercontent.com/HereHaveTheseFlowers/anyobjects/6f0e29228a014516e0437a4e46d4668554a2f771/public/objects

# Базовый URL сайта для старых картинок /objects/N/main.png
SITE_BASE_URL=https://anyobjects.ru

# Firebase Storage SDK (по умолчанию выкл. — при исчерпанной квоте бесполезен)
# USE_FIREBASE_STORAGE=1
